DATABASE_URL="postgresql://prosper:prosper@localhost:5432/prosper_hotel"
TEST_DATABASE_URL="postgresql://prosper:prosper@localhost:5432/prosper_hotel_test"

# Error tracking (Sentry). Same DSN in both — NEXT_PUBLIC_ is exposed to the
# browser bundle at build time, SENTRY_DSN is read server-side only.
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
# Needed only for source map upload at build time (CI). Not needed for local dev.
SENTRY_AUTH_TOKEN=""
