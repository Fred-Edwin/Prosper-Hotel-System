generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// docs/architecture.md: location is the cutting dimension, not an attribute.
enum LocationCode {
  restaurant
  canteen
}

// docs/architecture.md: four roles, drawn from how the business runs.
enum StaffRole {
  owner
  store_manager
  cashier
  attendant
}

model Location {
  id                  String               @id @default(cuid())
  code                LocationCode         @unique
  name                String
  staff               StaffMember[]
  movements           StockMovement[]
  ingredientMovements IngredientMovement[]
  sales               Sale[]
  handovers           Handover[]
  expenses            Expense[]
  stockCounts         StockCount[]
  assets              Asset[]
  repayments          Repayment[]
  transfersSent       Transfer[]           @relation("TransferFromLocation")
  transfersReceived   Transfer[]           @relation("TransferToLocation")

  @@map("locations")
}

model StaffMember {
  id                  String               @id @default(cuid())
  name                String               @unique
  phone               String               @unique
  pinHash             String
  role                StaffRole
  locationId          String
  location            Location             @relation(fields: [locationId], references: [id])
  // proposal.md §11: "a daily rate set for each" — minor units, same
  // convention as Product.priceMinor. Pay calculation itself (days worked
  // x rate) is a follow-on ticket; this ticket only stores the rate.
  dailyRateMinor      Int
  // docs/architecture.md: deactivated, never deleted — a former employee's
  // sales must stay attributed to them.
  active              Boolean              @default(true)
  createdAt           DateTime             @default(now())
  sessions            Session[]
  movements           StockMovement[]
  ingredientMovements IngredientMovement[]
  sales               Sale[]
  handovers           Handover[]
  expenses            Expense[]
  expensesPaidTo      Expense[]            @relation("ExpensePayee")
  stockCounts         StockCount[]
  daysWorked          DaysWorked[]         @relation("DaysWorkedByStaff")
  daysWorkedRecorded  DaysWorked[]         @relation("DaysWorkedRecordedBy")
  repayments          Repayment[]
  transfersSent       Transfer[]           @relation("TransferSentBy")
  transfersConfirmed  Transfer[]           @relation("TransferConfirmedBy")

  @@map("staff_members")
}

// docs/architecture.md: catalogue owns products; stock owns movements.
// Trimmed to what the tracer slice needs — see CONTEXT.md for the full
// four-kind vocabulary this mirrors.
enum ProductKind {
  goods
  cooked_food
  service
  packaging
}

model Product {
  id                 String          @id @default(cuid())
  name               String          @unique
  kind               ProductKind
  // Minor units (e.g. cents), never float — avoids rounding drift in money
  // figures. Null means no price set, distinct from priced-at-zero.
  priceMinor         Int?
  // Convenience figure only, not the authoritative cost history (that's
  // stock's movement ledger). Null until a delivery is received. Same
  // running-average update as Ingredient.lastKnownCostMinor (formulas.md
  // §3) — applies to purchased goods, not recipe-costed cooked food.
  lastKnownCostMinor Int?
  // Ticket 44: null means no threshold defined, distinct from a threshold
  // of zero — same nullable-until-set convention as priceMinor above.
  lowStockLevel      Int?
  // docs/architecture.md: deactivated, never deleted — a sold product must
  // stay attributed on historical sales even after withdrawal from sale.
  active             Boolean         @default(true)
  createdAt          DateTime        @default(now())
  movements          StockMovement[]
  recipes            Recipe[]
  saleLines          SaleLine[]
  // Nullable and single, per ticket 41: existing products and new ones the
  // owner hasn't categorised yet must remain valid; one flat category, no
  // hierarchy. Deactivating a category never clears this — an already
  // categorised product keeps reading its category.
  categoryId         String?
  category           Category?       @relation(fields: [categoryId], references: [id])

  @@map("products")
}

// Owner-managed reference data for grouping products (ticket 41) — split
// out of ticket 39's Product ledger once its design precedent's
// food/drinks/snacks/etc. category turned out to have no equivalent here,
// only the fixed ProductKind enum. Same lifecycle as Ingredient:
// deactivate, never delete, since a product may already reference it.
model Category {
  id        String    @id @default(cuid())
  name      String    @unique
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  products  Product[]

  @@map("categories")
}

model Ingredient {
  id                 String               @id @default(cuid())
  name               String               @unique
  // Free text per the ticket — kg, litre, packet, whatever the owner enters.
  unitOfMeasure      String
  // Convenience figure only, not the authoritative cost history (that's
  // stock's movement ledger once receiving is built). Null until known.
  lastKnownCostMinor Int?
  // Ticket 44: same nullable-until-set convention as Product.lowStockLevel.
  lowStockLevel      Int?
  active             Boolean              @default(true)
  createdAt          DateTime             @default(now())
  recipeLines        RecipeLine[]
  movements          IngredientMovement[]

  @@map("ingredients")
}

// docs/scope.md "Asset register": the durable things the business owns
// (equipment, furniture, plates, spoons), distinct from stock's consumable
// inventory. Never individually serialized — one row per asset type per
// location, quantity accumulates on repeat purchase. Retirement is a
// filter-only soft delete (retiredAt), deliberately not the visible
// active/dimmed pattern money-touching records use — a retired asset must
// not appear in the owner's UI at all, per the confirmed divergence from
// deactivateIngredient/deactivateProduct.
model Asset {
  id         String    @id @default(cuid())
  name       String
  locationId String
  location   Location  @relation(fields: [locationId], references: [id])
  quantity   Int
  // Optional: assets already owned before the system existed can be
  // recorded without a fabricated historical Expense.
  expenseId  String?   @unique
  expense    Expense?  @relation(fields: [expenseId], references: [id])
  retiredAt  DateTime?
  createdAt  DateTime  @default(now())

  @@unique([name, locationId])
  @@map("assets")
}

// docs/architecture.md "Records that must not move silently": a recipe
// change is a new version, never an edit. effectiveFrom + createdAt lets
// "the recipe in force on date X" be answered without a separate history
// table — the current version is simply the latest effectiveFrom <= X.
model Recipe {
  id            String       @id @default(cuid())
  productId     String
  product       Product      @relation(fields: [productId], references: [id])
  // Quantity of the output product this recipe is expected to produce.
  // ADR 0005: this is per-unit-cost and yield-variance input only — it
  // never feeds cost of goods sold.
  yieldQuantity Int
  effectiveFrom DateTime
  createdAt     DateTime     @default(now())
  lines         RecipeLine[]

  @@map("recipes")
}

model RecipeLine {
  id           String     @id @default(cuid())
  recipeId     String
  recipe       Recipe     @relation(fields: [recipeId], references: [id])
  ingredientId String
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id])
  quantity     Int

  @@map("recipe_lines")
}

// Trimmed subset of CONTEXT.md's full reason list (received, issued,
// produced, transferred, sold, sold-derived, wasted, consumed, given away,
// corrected) — enough for the tracer's receive/sell pattern. The full list
// is deferred to the real stock ticket.
// consumed/given_away added by ticket 15: CONTEXT.md treats wasted,
// consumed and given-away as siblings the client reads together but
// distinguishes per entry — reason is already the place that distinction
// lives, so no separate sub-field.
// issued added by ticket 18: an ingredient leaving the store for the
// kitchen — a store movement (CONTEXT.md's Stock Movement split), not a
// product being created.
// produced added by ticket 19: cooked food coming into existence at
// selling location — a product movement, priced at selling value, cost of
// sales, and profit, unlike issuing's plain ingredient relocation. Also
// used on the IngredientMovement side is `issued`, reused rather than a
// separate reason — the ingredients really did leave the store for this
// production run.
// sold_derived (ticket 24) retired 2026-08-13: the canteen now records
// real sales the same as the restaurant — see docs/proposal.md §4 and
// docs/architecture.md's canteen comparison table for why. Replaced by
// transfer_shortfall (below), a different reason for a different event.
//
// transfer_shortfall added 2026-08-13, alongside the Transfer model: the
// gap between what a transfer's sender recorded as sent and what the
// receiver confirmed as received. Distinct from wastage, from a
// stock-count correction, and from ordinary shrinkage — clearly
// attributable to the transfer itself, per REQ-02 Part A
// (docs/feature-requests.md). Written on the *receiving* location only,
// at the point of confirmation, quantity always 0 — never on the
// sending side, since the sender's stock already left at the sent
// quantity regardless of what arrives, and the loss is already fully
// reflected by the paired incoming `transferred` row being only
// +confirmedQuantity. This row is a reportable, attributable marker
// ("N lost in transit on this transfer"), not a further stock
// deduction — deducting again would double-count the same missing
// unit. The actual gap size lives on Transfer.sentQuantity −
// Transfer.confirmedQuantity, which any report reads from directly.
enum StockMovementReason {
  received
  transferred
  sold
  transfer_shortfall
  wasted
  consumed
  given_away
  issued
  produced
  corrected
}

// CONTEXT.md: fulfilment and payment are independent facts on a sale.
// Delivery is deliberately not wired by any ticket yet — the enum carries
// it because CONTEXT.md says "there is no third case", not because the
// counter-sale ticket writes it.
enum SaleFulfilment {
  counter
  delivery
}

// CONTEXT.md: cash and M-Pesa are never pooled; credit is a payment line
// like any other, settled later. Credit is deferred to ticket 08 — this
// enum carries it for the same reason SaleFulfilment carries delivery.
enum PaymentMethod {
  cash
  mpesa
  credit
}

// CONTEXT.md: "goods or services leaving the business in exchange for
// value, recorded at a location by a staff member." Restaurant-only in
// this ticket; the canteen records Takings instead (see docs/architecture.md).
// Never edited or deleted per architecture.md's reversal-only model — void
// (ticket 09) adds a reversing entry rather than touching this row.
model Sale {
  id               String         @id @default(cuid())
  locationId       String
  location         Location       @relation(fields: [locationId], references: [id])
  staffMemberId    String
  staffMember      StaffMember    @relation(fields: [staffMemberId], references: [id])
  fulfilment       SaleFulfilment
  // Required when fulfilment = delivery, independent of payment method —
  // ticket 11. Null for a counter sale.
  customerId       String?
  customer         Customer?      @relation(fields: [customerId], references: [id])
  // Minor units, same convention as Product.priceMinor. Sum of line
  // quantity x product price at the time of sale — stored rather than
  // recomputed, because a later product price change must not reshape a
  // past sale's total.
  totalMinor       Int
  // Present only when fulfilment = delivery. Added on top of product-line
  // value to form totalMinor; kept as its own figure (not blended into line
  // totals) so a later reporting stage can tell delivery income apart from
  // product revenue — ticket 11.
  deliveryFeeMinor Int?
  lines            SaleLine[]
  paymentLines     PaymentLine[]
  occurredAt       DateTime       @default(now())
  // Ticket 45 — architecture.md's "Changing a closed day": every entry
  // carries an effective date and an entered date (occurredAt), normally
  // identical. Defaults to occurredAt for every ordinarily-recorded sale;
  // set explicitly, in the past, only by recordSaleCorrection.
  effectiveAt      DateTime       @default(now())
  // Set only by recordSaleCorrection — marks this Sale as a backdated
  // correction rather than an ordinary sale, so Activity can flag it.
  isCorrection     Boolean        @default(false)
  correctionReason String?
  // Reversal, not deletion — docs/architecture.md's data-lifecycle rule.
  // Unset by anything in this ticket; the void action itself is ticket 10.
  voided           Boolean        @default(false)
  voidedAt         DateTime?
  voidedBy         String?

  @@map("sales")
}

model SaleLine {
  id         String  @id @default(cuid())
  saleId     String
  sale       Sale    @relation(fields: [saleId], references: [id])
  productId  String
  product    Product @relation(fields: [productId], references: [id])
  quantity   Int
  // The product's priceMinor at the moment of sale — see Sale.totalMinor.
  priceMinor Int

  @@map("sale_lines")
}

model PaymentLine {
  id          String        @id @default(cuid())
  saleId      String
  sale        Sale          @relation(fields: [saleId], references: [id])
  method      PaymentMethod
  amountMinor Int
  // Required for credit lines only — CONTEXT.md: "any staff member may
  // extend credit provided the customer is named." Null for cash/M-Pesa.
  customerId  String?
  customer    Customer?     @relation(fields: [customerId], references: [id])

  @@map("payment_lines")
}

// Ticket 36 — formulas.md §11: "owed by a customer = credit given −
// repayments." Symmetric to a credit PaymentLine but not tied to a Sale —
// a repayment is money coming in against existing credit, not a sale of
// goods. Append-only, never edited, only reversible — same discipline as
// DrawingRepayment.
model Repayment {
  id            String      @id @default(cuid())
  customerId    String
  customer      Customer    @relation(fields: [customerId], references: [id])
  locationId    String
  location      Location    @relation(fields: [locationId], references: [id])
  staffMemberId String
  staffMember   StaffMember @relation(fields: [staffMemberId], references: [id])
  amountMinor   Int
  occurredAt    DateTime    @default(now())
  reversed      Boolean     @default(false)
  reversedAt    DateTime?

  @@map("repayments")
}

// Added 2026-08-13 — REQ-02 Part A / docs/scope.md's "Canteen: real
// sales, two-sided transfers, retiring count-derived sales". A transfer
// used to be a single atomic pair of movement rows (both locations'
// stock changed in the same instant, no acknowledgement). It is now a
// two-step event: the sender's stock still leaves immediately (the
// outgoing StockMovement/IngredientMovement row is written at send
// time, same as before), but the receiver's stock does not increase
// until they separately confirm what actually arrived — the incoming
// row, and any transfer_shortfall row for a confirmed-short quantity,
// are written only at confirmation. Applies in both directions
// (restaurant→canteen and canteen→restaurant), not special-cased to
// either location.
//
// While `status = pending`, the transfer is "in transit": it has
// already reduced the sender's stock (via the outgoing movement, linked
// by sharing this row's id as `transferId`) but has not yet increased
// the receiver's — neither location's stock count includes it.
//
// `id` doubles as the `transferId` grouping value already used on
// StockMovement/IngredientMovement (ticket 21) — a plain shared string,
// not a hard foreign key, matching how `receiptId` already groups
// movement rows without a relation. Product-or-ingredient uses the same
// itemType/itemId string-discriminator convention as StockCountLine
// (this file, below), not two nullable relations.
enum TransferItemType {
  product
  ingredient
}

enum TransferStatus {
  pending
  confirmed
  // A sender's own undo of a still-pending send, before the receiver has
  // confirmed anything — same "void your own entry, same day, no
  // permission needed" principle as everywhere else (docs/architecture.md's
  // data lifecycle). Distinct from an already-confirmed transfer's
  // reversal, which restores stock at both locations via a new opposite
  // transfer instead (see stock/logic.ts's reverseTransfer) — a
  // cancelled transfer never had an incoming movement to undo.
  cancelled
}

model Transfer {
  id                       String           @id @default(cuid())
  fromLocationId           String
  fromLocation             Location         @relation("TransferFromLocation", fields: [fromLocationId], references: [id])
  toLocationId             String
  toLocation               Location         @relation("TransferToLocation", fields: [toLocationId], references: [id])
  itemType                 TransferItemType
  itemId                   String
  sentQuantity             Int
  status                   TransferStatus   @default(pending)
  sentByStaffMemberId      String
  sentByStaffMember        StaffMember      @relation("TransferSentBy", fields: [sentByStaffMemberId], references: [id])
  sentAt                   DateTime         @default(now())
  // Populated only once confirmed. May differ from sentQuantity — a
  // shortfall is recorded as its own transfer_shortfall movement, not
  // silently absorbed. Never exceeds sentQuantity in ordinary use (there
  // is nothing to confirm beyond what was sent); not enforced at the DB
  // level, same trust-the-caller convention as the rest of this schema.
  confirmedQuantity        Int?
  confirmedByStaffMemberId String?
  confirmedByStaffMember   StaffMember?     @relation("TransferConfirmedBy", fields: [confirmedByStaffMemberId], references: [id])
  confirmedAt              DateTime?
  // Set when this transfer is itself a reversal of an earlier one (same
  // reversedTransferId convention as StockMovement/IngredientMovement) —
  // reversing an already-confirmed transfer is a new transfer in the
  // opposite direction, not an edit to this row.
  reversedTransferId       String?
  // Populated only when status = cancelled — the sender undoing their own
  // still-pending send. Always the same person as sentByStaffMemberId in
  // practice (only the sender or the owner may cancel), kept as its own
  // field rather than reusing sentByStaffMemberId so "who sent it" and
  // "who cancelled it" stay independently readable.
  cancelledByStaffMemberId String?
  cancelledAt              DateTime?

  @@map("transfers")
}

model StockMovement {
  id                 String              @id @default(cuid())
  productId          String
  product            Product             @relation(fields: [productId], references: [id])
  locationId         String
  location           Location            @relation(fields: [locationId], references: [id])
  // Signed: positive for stock arriving, negative for stock leaving.
  // docs/architecture.md: a stock level is not a stored number, it is the
  // sum of the movements.
  quantity           Int
  reason             StockMovementReason
  // Populated only for wasted/consumed/given_away (ticket 15) — the two
  // ways CONTEXT.md's Non-sales Stock Consumption is valued, snapshotted
  // at record time same as SaleLine.priceMinor, so a later price/cost
  // change never reshapes a past entry. Null for every other reason.
  costBasisMinor     Int?
  sellingValueMinor  Int?
  isEstimated        Boolean?
  staffMemberId      String
  staffMember        StaffMember         @relation(fields: [staffMemberId], references: [id])
  occurredAt         DateTime            @default(now())
  // Shared by the outgoing and incoming rows of one transfer (ticket 21).
  // Unlike a receipt this spans product and ingredient movement tables, so
  // it remains a grouping value rather than a relation to a new record.
  transferId         String?
  // Set on a reversal's own rows to the transferId of the transfer it
  // undoes (ticket 21) — lets the history view mark the original as
  // reversed and refuse to reverse it twice, without a relation table.
  reversedTransferId String?
  // Shared by every line recorded in the same receiving call (ticket 22),
  // same convention as IngredientMovement.receiptId — a delivery may mix
  // product and ingredient lines under one receipt id. Null for every
  // other reason.
  receiptId          String?

  @@map("stock_movements")
}

// CONTEXT.md: "store movement" — an Ingredient moving through the store,
// valued at cost rather than selling price. Kept separate from
// StockMovement (which moves Product) rather than a nullable dual-FK on one
// table, per ticket 12's decision — the two families are read as genuinely
// separate records by the client.
model IngredientMovement {
  id                 String              @id @default(cuid())
  ingredientId       String
  ingredient         Ingredient          @relation(fields: [ingredientId], references: [id])
  locationId         String
  location           Location            @relation(fields: [locationId], references: [id])
  // Unsigned in this ticket — receiving is the only reason written so far.
  // A future issuing/wastage ticket may need this signed, same as
  // StockMovement.quantity; revisit then rather than guessing the sign
  // convention now.
  quantity           Int
  reason             StockMovementReason
  // Price paid per unit on this occasion — proposal.md: "prices are
  // entered per delivery rather than held as a fixed figure." Required for
  // `received`; unused for wasted/consumed/given_away (ticket 15), which
  // use costBasisMinor/sellingValueMinor below instead — an ingredient's
  // per-unit purchase cost doesn't change when some of it is wasted.
  unitCostMinor      Int?
  // Populated only for wasted/consumed/given_away (ticket 15), same
  // convention as StockMovement. Ingredients have no selling price
  // (CONTEXT.md: never sold on their own), so sellingValueMinor is always
  // null here — only costBasisMinor/isEstimated apply.
  costBasisMinor     Int?
  sellingValueMinor  Int?
  isEstimated        Boolean?
  staffMemberId      String
  staffMember        StaffMember         @relation(fields: [staffMemberId], references: [id])
  occurredAt         DateTime            @default(now())
  // Shared by every line recorded in the same recordIngredientReceipt call
  // — ticket 16's Stock-category Expense references this, not an individual
  // line, so "the receipt this payment pays for" means the whole delivery.
  // Added retroactively (ticket 12 shipped without it); not a foreign key
  // to a separate table because no such table exists — grouping only.
  // Null for wasted/consumed/given_away (ticket 15): those movements have
  // no delivery to group under, and nothing reads receiptId off them —
  // findReceiptsAtLocation filters to reason = "received" already.
  receiptId          String?
  // Shared by the outgoing and incoming rows of one transfer (ticket 21).
  transferId         String?
  // Set on a reversal's own rows to the transferId of the transfer it
  // undoes (ticket 21) — lets the history view mark the original as
  // reversed and refuse to reverse it twice, without a relation table.
  reversedTransferId String?

  @@map("ingredient_movements")
}

model Session {
  id            String      @id @default(cuid())
  token         String      @unique
  staffMemberId String
  staffMember   StaffMember @relation(fields: [staffMemberId], references: [id])
  expiresAt     DateTime
  createdAt     DateTime    @default(now())

  @@map("sessions")
}

// proposal.md §11: "Days worked are recorded" — one row per staff member
// per date, owner-recorded. The unique constraint is what makes recording
// the same date twice an edit in place rather than a duplicate (ticket 35),
// the same enforcement style as Handover's same-day rule but as a DB
// constraint since there's no "expected figure" here to recompute.
// paidAs mirrors Expense.receiptId's grouping-value pattern: set to the
// paying Expense's id once a wage payment covers this day, null until then.
model DaysWorked {
  id                      String      @id @default(cuid())
  staffMemberId           String
  staffMember             StaffMember @relation("DaysWorkedByStaff", fields: [staffMemberId], references: [id])
  date                    DateTime
  recordedByStaffMemberId String
  recordedByStaffMember   StaffMember @relation("DaysWorkedRecordedBy", fields: [recordedByStaffMemberId], references: [id])
  paidAs                  String?
  createdAt               DateTime    @default(now())
  updatedAt               DateTime    @updatedAt

  @@unique([staffMemberId, date])
  @@map("days_worked")
}

// CONTEXT.md: a named person the business deals with by name rather than
// anonymously. No `active` flag and no delete — a customer with a sale
// attributed to them must remain resolvable, permanently, and names are
// not unique (not identifiers in real life).
model Customer {
  id           String        @id @default(cuid())
  name         String
  phone        String?
  createdAt    DateTime      @default(now())
  paymentLines PaymentLine[]
  sales        Sale[]
  repayments   Repayment[]

  @@map("customers")
}

// CONTEXT.md: money physically handed to the owner, for one location, one
// day, checked against an expected amount. Restaurant only for now —
// canteen's expected figure needs Takings (Stage 4, not built).
// "One per staff member/location/day" is enforced in cash/logic.ts (find
// today's row, update in place) rather than a DB constraint — same
// same-day-edit style as Sale's void rule, not a unique index.
// expectedCashMinor/expectedMpesaMinor are computed once at record time from
// that day's recorded sales and stored, not recomputed on every read — a
// later void must not silently reshape an already-recorded handover.
// docs/design.md's blind-count decision: the staff member who records this
// never sees these two fields back from the API. Only the owner (ticket 14)
// reads them.
model Handover {
  id                 String      @id @default(cuid())
  locationId         String
  location           Location    @relation(fields: [locationId], references: [id])
  staffMemberId      String
  staffMember        StaffMember @relation(fields: [staffMemberId], references: [id])
  // At the restaurant, cash and M-Pesa are each a real, independently
  // expected figure — both non-null. At the canteen (2026-08-13 revision
  // — a sale carries no payment method at entry, so the split isn't
  // knowable from the sale record), expectedCashMinor holds the
  // combined expected total and expectedMpesaMinor is left null,
  // meaning "not tracked separately here — see expectedCashMinor for
  // the whole figure," not "expected zero M-Pesa." Any comparison
  // against actualCashMinor/actualMpesaMinor must branch on this null
  // rather than assume both are always populated.
  expectedCashMinor  Int
  expectedMpesaMinor Int?
  actualCashMinor    Int
  actualMpesaMinor   Int
  occurredAt         DateTime    @default(now())
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  @@map("handovers")
}

// Takings (cash/M-Pesa totals declared separately from a handover) was
// retired 2026-08-13 — see CONTEXT.md's "Takings — retired" entry. The
// canteen now records real sales the same as the restaurant, and hands
// over through the same single Handover step; a separate declaration
// had nothing left to answer that Handover doesn't already capture.

// CONTEXT.md's Expense: money the owner pays out, one of four categories
// that behave differently in profit — see docs/architecture.md and
// ticket 16.
enum ExpenseCategory {
  stock
  running
  asset
  drawing
}

// Owner-only, per architecture.md ("only the owner pays money out").
// Reversal, not deletion — same principle as Sale.voided.
model Expense {
  id                 String          @id @default(cuid())
  locationId         String
  location           Location        @relation(fields: [locationId], references: [id])
  staffMemberId      String
  staffMember        StaffMember     @relation(fields: [staffMemberId], references: [id])
  category           ExpenseCategory
  // Set only for a wages payment (category = running): who was paid, as
  // distinct from staffMemberId above (who — the owner — recorded the
  // payment). Ticket 35.
  payeeStaffMemberId String?
  payeeStaffMember   StaffMember?    @relation("ExpensePayee", fields: [payeeStaffMemberId], references: [id])
  // Cash or M-Pesa only — never credit, which is a sales-side concept for
  // money coming in, not a way the business pays money out. Ticket 31's
  // running balance needs this to split money-out the same way money-in
  // (Handover) already is. Defaulted to cash for rows recorded before
  // this field existed, since there is no real record of which method
  // they used.
  paymentMethod      PaymentMethod   @default(cash)
  amountMinor        Int
  note               String?
  // Required only for category = stock — the IngredientMovement.receiptId
  // group this payment pays for. Not a Prisma relation: receiptId is a
  // grouping value shared by several IngredientMovement rows, not a row's
  // own id, so there is nothing singular to point a foreign key at.
  receiptId          String?
  occurredAt         DateTime        @default(now())
  reversed           Boolean         @default(false)
  reversedAt         DateTime?
  reversedBy         String?
  drawingDebt        DrawingDebt?
  asset              Asset?

  @@map("expenses")
}

// CONTEXT.md's Cash Movement: "money the owner takes for personal use is
// recorded as a cash movement out and a debt owed back to the business."
// One row per drawing-category Expense; the running total owed is the sum
// of unreversed rows (ticket 16 — no "settled" concept exists yet, so this
// is deliberately the simplest honest shape: an ever-growing figure).
model DrawingDebt {
  id          String    @id @default(cuid())
  expenseId   String    @unique
  expense     Expense   @relation(fields: [expenseId], references: [id])
  amountMinor Int
  reversed    Boolean   @default(false)
  reversedAt  DateTime?

  @@map("drawing_debts")
}

// Ticket 32 — symmetric, append-only counterpart to DrawingDebt: a
// repayment against the outstanding drawings balance. Same shape
// discipline (never edited, only added to or marked reversed).
model DrawingRepayment {
  id            String        @id @default(cuid())
  amountMinor   Int
  // Cash or M-Pesa only — never credit, same reasoning as Expense.
  // Defaulted to cash for rows recorded before this field existed, since
  // there is no real record of which method they used. Ticket 40 — the
  // cash ledger needs a method on every transaction, and repayments are
  // one of its categories.
  paymentMethod PaymentMethod @default(cash)
  recordedBy    String
  occurredAt    DateTime      @default(now())
  reversed      Boolean       @default(false)
  reversedAt    DateTime?

  @@map("drawing_repayments")
}

// docs/architecture.md's "physical count": a location-generic count of
// products and/or ingredients on hand. One row groups the lines recorded
// together, same shape as IngredientMovement.receiptId grouping a
// delivery. Ticket 20.
model StockCount {
  id            String           @id @default(cuid())
  locationId    String
  location      Location         @relation(fields: [locationId], references: [id])
  staffMemberId String
  staffMember   StaffMember      @relation(fields: [staffMemberId], references: [id])
  occurredAt    DateTime         @default(now())
  lines         StockCountLine[]

  @@map("stock_counts")
}

// itemType + itemId rather than two nullable FKs, matching CONTEXT.md's
// product/ingredient split (never both) and precedent
// (recordNonSalesConsumption's discriminated itemType). expectedQuantity is
// snapshotted at count time per the ticket — later movements must not
// reshape a past count's comparison.
model StockCountLine {
  id               String     @id @default(cuid())
  stockCountId     String
  stockCount       StockCount @relation(fields: [stockCountId], references: [id])
  itemType         String
  itemId           String
  countedQuantity  Int
  expectedQuantity Int
  // Set only once the owner applies the correction from this line's
  // difference — ticket's "correcting an already-corrected line is
  // rejected" rule reads off this being non-null.
  correctedAt      DateTime?
  correctedBy      String?

  @@map("stock_count_lines")
}
